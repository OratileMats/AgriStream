@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">AgriStream IoT Dashboard</h2>
            <p class="text-muted mb-0">Real-time agricultural monitoring and management</p>
        </div>
        <span id="liveBadge" class="badge bg-secondary p-2">Connecting…</span>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 stat-card"><div class="card-body">
                <p class="text-muted mb-1">Registered Users</p>
                <h2 class="fw-bold">@Model.UserCount</h2>
                <span class="text-success">Azure SQL</span>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 stat-card"><div class="card-body">
                <p class="text-muted mb-1">Connected Devices</p>
                <h2 class="fw-bold">@Model.DeviceCount</h2>
                <span class="text-success">@Model.IrrigatingCount irrigating now</span>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 stat-card"><div class="card-body">
                <p class="text-muted mb-1">Average Soil Moisture</p>
                <h2 class="fw-bold" id="avgMoisture">–</h2>
                <span class="text-success">Latest reading per sensor</span>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 stat-card"><div class="card-body">
                <p class="text-muted mb-1">Average Temperature</p>
                <h2 class="fw-bold" id="avgTemp">–</h2>
                <span class="text-success">Latest reading per sensor</span>
            </div></div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Latest Sensor Readings <small class="text-muted fw-normal">(via Azure Function → Table Storage)</small></h5>
            <small class="text-muted" id="lastUpdated"></small>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Sensor</th><th>Farm</th><th>Soil Moisture</th><th>Temperature</th><th>Humidity</th><th>Status</th><th>Recorded</th></tr></thead>
                    <tbody id="telemetryBody"><tr><td colspan="7" class="text-muted">Loading…</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100"><div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold">Irrigation Control</h5>
                    <p class="text-muted mb-0">Trigger or stop irrigation for any device.</p>
                </div>
                <a asp-controller="Devices" asp-action="Index" class="btn btn-success">Open</a>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100"><div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold">Drone Image Management</h5>
                    <p class="text-muted mb-0">Upload and view aerial farm images.</p>
                </div>
                <a asp-controller="Media" asp-action="Index" class="btn btn-success">Open</a>
            </div></div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white py-3"><h5 class="mb-0 fw-bold">Recent Upload Processing (Blob trigger audit)</h5></div>
        <div class="card-body">
            @if (!Model.RecentAudit.Any())
            {
                <p class="text-muted mb-0">No uploads processed yet.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm">
                    <thead><tr><th>Blob</th><th>Farm</th><th>Size</th><th>Status</th><th>Processed</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.RecentAudit)
                    {
                        <tr><td>@a.BlobName</td><td>@a.Farm</td><td>@((a.SizeBytes / 1024.0).ToString("N0")) KB</td>
                            <td><span class="badge bg-success">@a.Status</span></td><td>@(a.ProcessedAt?.ToString("yyyy-MM-dd HH:mm:ss"))</td></tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const badge = document.getElementById('liveBadge');

    function render(data) {
        const latest = new Map();
        data.forEach(d => { if (!latest.has(d.sensorId)) latest.set(d.sensorId, d); });
        const rows = [...latest.values()].sort((a, b) => a.sensorId.localeCompare(b.sensorId));
        const body = document.getElementById('telemetryBody');

        if (!rows.length) {
            body.innerHTML = '<tr><td colspan="7" class="text-muted">No telemetry yet. Use “Simulate readings” on the Devices page.</td></tr>';
            return;
        }
        body.innerHTML = rows.map(d => `
            <tr>
              <td>${esc(d.sensorId)}</td><td>${esc(d.farmName)}</td>
              <td>${d.soilMoisture.toFixed(1)}%</td><td>${d.temperatureC.toFixed(1)}°C</td><td>${d.humidity.toFixed(1)}%</td>
              <td><span class="badge ${d.status === 'Attention' ? 'bg-warning text-dark' : 'bg-success'}">${esc(d.status)}</span></td>
              <td>${new Date(d.recordedAt).toLocaleTimeString()}</td>
            </tr>`).join('');

        const avg = f => rows.reduce((s, r) => s + r[f], 0) / rows.length;
        document.getElementById('avgMoisture').textContent = avg('soilMoisture').toFixed(1) + '%';
        document.getElementById('avgTemp').textContent = avg('temperatureC').toFixed(1) + '°C';
        document.getElementById('lastUpdated').textContent = 'Updated ' + new Date().toLocaleTimeString();
    }

    async function load() {
        try {
            const r = await fetch('@Url.Action("Telemetry", "Home")', { headers: { 'Accept': 'application/json' } });
            if (!r.ok) throw new Error(r.status);
            render(await r.json());
            badge.className = 'badge bg-success p-2'; badge.textContent = 'System Online';
        } catch (e) {
            badge.className = 'badge bg-danger p-2'; badge.textContent = 'Telemetry unavailable';
        }
    }
    load();
    setInterval(load, 5000);
</script>
}
